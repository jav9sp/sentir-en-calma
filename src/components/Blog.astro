---
import posts from "../data/posts.json" 
---

<div class="max-w-5xl mx-auto px-6 grid gap-8 md:grid-cols-3">
  {posts.map((post) => (
    <a
      href={post.link}
      class="block bg-white rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-transform hover:-translate-y-1"
    >
      <!-- Imagen -->
      <img
        src={post.imagen}
        alt={post.titulo}
        class="w-full h-48 object-cover"
      />
  
      <!-- Contenido -->
      <div class="p-6">
        <h3 class="text-xl font-semibold text-green-800 mb-2">{post.titulo}</h3>
        <p class="text-gray-600 text-sm">{post.resumen}</p>
      </div>
    </a>
  ))}
</div>
