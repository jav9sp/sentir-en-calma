---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Recursos Gratuitos | Sentir en Calma"
  description="Encuentra recursos gratuitos para autodescubrirte y trabajar por tu cuenta.">
  <main class="max-w-6xl mx-auto px-6 py-20">
    <section class="text-center mb-16">
      <h1 class="text-4xl font-bold text-gray-800 mb-4">Recursos Gratuitos</h1>
      <p class="text-gray-600 text-lg">
        Descarga herramientas prácticas para acompañarte en tu camino de
        bienestar emocional.
      </p>
    </section>

    <section class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <!-- Recurso 1 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition">
        <h2 class="text-2xl font-semibold text-gray-800 mb-3">
          Guía de Autocuidado
        </h2>
        <p class="text-gray-600 mb-4">
          Un checklist diario para reconectar contigo y cuidar tu bienestar
          mental y físico.
        </p>
        <a
          href="/descargas/guia-autocuidado.pdf"
          class="inline-block mt-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition"
          download>
          Descargar
        </a>
      </div>

      <!-- Recurso 2 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition">
        <h2 class="text-2xl font-semibold text-gray-800 mb-3">
          Diario de Gratitud
        </h2>
        <p class="text-gray-600 mb-4">
          Un diario para escribir tus pensamientos positivos y cultivar la
          gratitud diaria.
        </p>
        <a
          href="/descargas/diario-gratitud.pdf"
          class="inline-block mt-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition"
          download>
          Descargar
        </a>
      </div>

      <!-- Recurso 3 -->
      <div class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition">
        <h2 class="text-2xl font-semibold text-gray-800 mb-3">
          Ejercicios de Respiración
        </h2>
        <p class="text-gray-600 mb-4">
          Guía rápida con ejercicios sencillos para reducir el estrés en
          momentos difíciles.
        </p>
        <a
          href="/descargas/ejercicios-respiracion.pdf"
          class="inline-block mt-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 transition"
          download>
          Descargar
        </a>
      </div>
    </section>
  </main>
</Layout>
